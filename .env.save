# Configuration de l'application
NODE_ENV=development
PORT=3000

# Configuration de la base de données PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=magasinx
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Configuration de Valkey
VALKEY_URL=valkey://valkey:6379

# Configuration de l'application (à personnaliser)
JWT_SECRET=change_this_to_a_very_secure_secret
JWT_EXPIRES_IN=1d

# Configuration du cache (optionnel)
CACHE_TTL=3600
pnpm test test/common/decorators/is-phone-number.decorator.spec.ts



